verflow:hidden;background:var(--ink-2)}\ntable{width:100%;border-collapse:collapse;font-size:14.5px}\ncaption{text-align:left;padding:20px 24px;color:var(--mute);font-size:13px;border-bottom:1px solid var(--line)}\nth,td{padding:16px 22px;text-align:left;vertical-align:top;border-bottom:1px solid #232a26}\nthead th{background:#101413;font-size:13px;letter-spacing:.06em;color:var(--mute);font-weight:600;white-space:nowrap}\nthead th.featured{color:var(--lime)}\ntbody th{font-weight:600;color:var(--mute);width:150px;font-size:13px;letter-spacing:.04em}\ntbody tr:last-child th,tbody tr:last-child td{border-bottom:0}\ntd.price{font-size:22px;font-weight:800;color:var(--paper);white-space:nowrap}\ntd.price small{display:block;font-size:12.5px;font-weight:500;color:var(--mute);margin-top:4px}\n.col-featured{background:#131a12}\n.tag{display:inline-block;margin-left:8px;padding:1px 8px;border-radius:999px;background:var(--lime);color:#0b0d0c;font-size:11px;font-weight:700;vertical-align:middle}\n.table-note{padding:18px 24px;font-size:12.5px;color:#7f8983;background:#0f1312}\n\n/* 客户端区块 */\n.client-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}\n.card{background:var(--ink-2);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 18px 42px rgba(0,0,0,.35);padding:24px}\n.card h3{font-size:17px;margin-bottom:10px}\n.card p{font-size:14.5px;color:#b6bfb9}\n.card .meta{margin-top:16px;font-size:12.5px;color:var(--lime);letter-spacing:.04em}\n.card .none{color:#7f8983}\n\n/* 使用说明 */\n.steps{display:grid;gap:14px;counter-reset:step}\n.step{display:grid;grid-template-columns:64px 1fr;gap:20px;background:var(--ink-2);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 18px 42px rgba(0,0,0,.3);padding:24px 26px;align-items:start}\n.step-num{font-size:30px;font-weight:800;color:var(--lime);line-height:1}\n.step h3{font-size:17px;margin-bottom:6px}\n.step p{font-size:14.5px;color:#b6bfb9}\n\n/* FAQ 双栏 */\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px 26px}\n.qa{background:var(--ink-2);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 18px 42px rgba(0,0,0,.3);padding:24px}\n.qa h3{font-size:16px;margin-bottom:10px;color:var(--paper)}\n.qa h3::before{content:\"Q\";display:inline-block;margin-right:10px;color:var(--lime);font-weight:800}\n.qa p{font-size:14.5px;color:#b6bfb9}\n\nfooter{padding:46px 0 60px;font-size:13px;color:#7f8983}\n.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:center}\nfooter a{color:var(--mute);text-decoration:none;border-bottom:1px solid var(--line)}\nfooter a:hover{color:var(--lime);border-color:var(--lime)}\n\n@media (max-width:860px){\n  .hero-grid{grid-template-columns:1fr;gap:36px}\n  .faq-grid{grid-template-columns:1fr}\n  .hero{padding:46px 0 56px}\n  section{padding:56px 0}\n  .topbar-inner{padding:12px 0}\n  .table-shell{overflow-x:auto}\n  table{min-width:640px}\n  .step{grid-template-columns:44px 1fr;gap:14px;padding:20px}\n  .step-num{font-size:24px}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap topbar-inner\">\n    <div class=\"mark\">MG<span>NB</span></div>\n    <nav class=\"anchors\" aria-label=\"页面内导航\">\n      <a href=\"#plans\">套餐对比</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#howto\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <header class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"eyebrow\">MGNB 页面说明</span>\n        <h1>MGNB<em>先看清条款，再决定买哪档。</em></h1>\n        <p class=\"hero-lead\">这个页面只做一件事：把三档套餐的差别、客户端的情况和使用顺序摆在同一屏里。你不需要猜，也不用翻别处。</p>\n        <ul class=\"hero-points\">\n          <li>套餐按流量、设备数、线路与支持逐项对照。</li>\n          <li>客户端仅说明已写入本文的信息，未确认的不写。</li>\n          <li>常见问题双栏并列，一问一答，不藏答案。</li>\n        </ul>\n        <div class=\"hero-cta\">\n          <a class=\"btn btn-main\" href=\"#plans\">查看套餐对比</a>\n          <a class=\"btn btn-ghost\" href=\"#faq\">先读常见问题</a>\n        </div>\n      </div>\n\n      <aside class=\"panel\" aria-label=\"套餐速览\">\n        <div class=\"panel-head\">\n          <h2>速览</h2>\n          <strong>三档</strong>\n        </div>\n        <ul class=\"panel-rows\">\n          <li><span>基础版</span><span>¥15 / 月</span></li>\n          <li><span>旗舰版</span><span>¥35 / 月</span></li>\n          <li><span>团队版</span><span>¥85 / 月</span></li>\n          <li><span>年付折算</span><span>十个月价</span></li>\n          <li><span>计费周期</span><span>月付 / 年付</span></li>\n          <li><span>客户端</span><span>见下方说明</span></li>\n        </ul>\n        <p class=\"panel-note\">价格与权益均以下方对比表为准。本文不提供下载地址，未确认的客户端信息一律不虚构。</p>\n      </aside>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"kicker\">套餐</p>\n          <h2>三档并排，差别写在同一行</h2>\n        </div>\n        <p>横向读一行，就能看到同一项权益在三档之间怎么变。年付价格按月付的十个月计。</p>\n      </div>\n\n      <div class=\"table-shell\">\n        <table>\n          MGNB 套餐对比。金额单位为人民币，月付与年付并列展示。\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th class=\"featured\">旗舰版<span class=\"tag\">推荐</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td class=\"price\">¥15<small>每月</small></td>\n              <td class=\"price col-featured\">¥35<small>每月</small></td>\n              <td class=\"price\">¥85<small>每月</small></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td class=\"price\">¥150<small>折合每月约 ¥12.5</small></td>\n              <td class=\"price col-featured\">¥350<small>折合每月约 ¥29.2</small></td>\n              <td class=\"price\">¥850<small>折合每月约 ¥70.8</small></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"col-featured\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"col-featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>基础流媒体</td>\n              <td class=\"col-featured\">全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>线路</th>\n              <td>普通线路节点池</td>\n              <td class=\"col-featured\">含 IPLC 专线，游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>定制路由</th>\n              <td>不支持</td>\n              <td class=\"col-featured\">不支持</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>常规工单</td>\n              <td class=\"col-featured\">7×24 优先工单</td>\n              <td>专属客户经理</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>个人日常浏览，设备不多</td>\n              <td class=\"col-featured\">多设备、看片与游戏并用</td>\n              <td>小组或公司统一安排</td>\n            </tr>\n          </tbody>\n        </table>\n        <p class=\"table-note\">表中未列出的能力，本文不做承诺。流量按月重置，超出后的处理方式请在使用前确认清楚。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"kicker\">客户端</p>\n          <h2>客户端这块，只写确定的部分</h2>\n        </div>\n        <p>没有可靠地址就不放链接。下面说明的是各平台的使用前提与留意点，不包含下载按钮。</p>\n      </div>\n\n      <div class=\"client-grid\">\n        <article class=\"card\">\n          <h3>桌面端</h3>\n          <p>在电脑上使用前，先确认系统版本与所需权限，再按套餐的设备额度决定登录几台。</p>\n          <p class=\"meta none\">下载地址：页面未提供</p>\n        </article>\n        <article class=\"card\">\n          <h3>移动端</h3>\n          <p>手机与平板算作独立设备，共用同一份同时在线额度。外出前留意当月已用流量。</p>\n          <p class=\"meta none\">下载地址：页面未提供</p>\n        </article>\n        <article class=\"card\">\n          <h3>路由器与共享</h3>\n          <p>团队版支持企业定制路由；基础版与旗舰版不提供该能力，需要独立设备分别登录。</p>\n          <p class=\"meta none\">配置说明：以实际获取为准</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"kicker\">使用说明</p>\n          <h2>四步之内走完流程</h2>\n        </div>\n        <p>顺序不复杂，但每一步都影响后面能不能顺利连上，建议按此执行。</p>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"step-num\">01</div>\n          <div>\n            <h3>先定档位</h3>\n            <p>数一下你有几台设备要同时在线，再看每月流量大概用多少。设备数和流量两项里，先卡住更紧的那一项。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">02</div>\n          <div>\n            <h3>再定周期</h3>\n            <p>只打算试一段时间就选月付；已经确定长期使用再选年付，年付按十个月计，中途变动的余地更小。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">03</div>\n          <div>\n            <h3>准备客户端</h3>\n            <p>在你要用的设备上安装对应客户端。本文不提供下载链接，请以你能确认的来源为准，不要从陌生页面获取安装包。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">04</div>\n          <div>\n            <h3>按额度登录</h3>\n            <p>登录设备数量不要超过套餐上限。超出后可能出现其中一台被挤下线，这是额度限制，不是故障。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <p class=\"kicker\">常见问题</p>\n          <h2>双栏问答，答案直接给</h2>\n        </div>\n        <p>八个问题覆盖价格、额度、线路与支持。读完还有疑问，再去看对比表对应那一行。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3>年付比月付便宜多少？</h3>\n          <p>三档年付都按十个月计：基础版 ¥150、旗舰版 ¥350、团队版 ¥850。相当于省掉两个月月付金额，没有其他隐藏折扣。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>同时在线设备怎么算？</h3>\n          <p>基础版 3 台、旗舰版 5 台、团队版 20 台。手机、平板、电脑分别计数，路由器共享同样占用额度。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>流量用超了会怎样？</h3>\n          <p>本文只说明每月流量额度为 100GB、300GB 与 1000GB。超额后的具体处理方式未在本文确认，请在下单前问清再决定。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>IPLC 专线是所有人都能用吗？</h3>\n          <p>不是。该项只写在旗舰版权益里，团队版走 VIP 专属高带宽节点，基础版为普通线路节点池。三档不要混着理解。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>从哪下载客户端？</h3>\n          <p>本页不提供下载地址。任何宣称是官方安装包的页面都请自行核实来源，不要在不确认的站点输入账号信息。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>团队版能定制什么？</h3>\n          <p>团队版写明支持企业定制路由，并配专属客户经理。具体能改到什么程度，属于需要单独沟通的部分，本文不代为承诺。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>支持能不能快一点？</h3>\n          <p>旗舰版为 7×24 优先工单，团队版有专属客户经理。基础版为常规工单，响应节奏与另外两档不同，按需选择。</p>\n        </article>\n        <article class=\"qa\">\n          <h3>可以先买一个月再换档吗？</h3>\n          <p>建议先按当前设备数和流量选月付试一档，用满一个月再决定是否升档或转年付。本文不对换档规则作额外说明。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap footer-inner\">\n    <span>MGNB · 本页信息仅限本文所列内容</span>\n    <span><a href=\"#plans\">回到套餐对比</a></span>\n  </div>\n</footer>",
